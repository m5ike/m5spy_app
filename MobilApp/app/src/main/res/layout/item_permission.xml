<?xml version="1.0" encoding="utf-8"?>
<!--
    Permission Item Layout for RecyclerView
    @author Michael KOJDL
    @version 1.0.0
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imagePermissionStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Permission Status"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPermissionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Camera" />

        <TextView
            android:id="@+id/textPermissionDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            tools:text="android.permission.CAMERA" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRequestPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grant"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>
