5.3 PREFERENCES MANAGER
-----------------------
Soubor: app/src/main/java/com/myspy/android/data/local/prefs/PrefsManager.kt
Obsah:
---
package com.myspy.android.data.local.prefs

import android.content.Context
import androidx.security.crypto.EncryptedSharedPreferences
import androidx.security.crypto.MasterKey
import dagger.hilt.android.qualifiers.ApplicationContext
import javax.inject.Inject
import javax.inject.Singleton

/**
 * Preferences Manager
 *
 * @author Michael KOJDL
 * @version 1.0.0
 * @revision 2025-10-30
 *
 * @description Správce šifrovaných SharedPreferences
 *
 * Použití:
 * ```kotlin
 * val uuid = prefsManager.getUuid()
 * prefsManager.saveApiKey("key123")
 * ```
 *
 * Závislosti:
 * - EncryptedSharedPreferences (androidx.security)
 *
 * Chybové hlášky:
 * - Žádné - používá safe defaults
 *
 * TODO:
 * - [ ] Přidat migration z plain SharedPreferences
 */
@Singleton
class PrefsManager @Inject constructor(
    @ApplicationContext private val context: Context
) {
    companion object {
        private const val PREFS_NAME = "myspy_secure_prefs"

        private const val KEY_UUID = "device_uuid"
        private const val KEY_API_KEY = "api_key"
        private const val KEY_REGISTERED = "is_registered"
        private const val KEY_FIRST_RUN = "is_first_run"
    }

    private val masterKey = MasterKey.Builder(context)
        .setKeyScheme(MasterKey.KeyScheme.AES256_GCM)
        .build()

    private val encryptedPrefs = EncryptedSharedPreferences.create(
        context,
        PREFS_NAME,
        masterKey,
        EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
        EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM
    )

    // UUID
    fun getUuid(): String = encryptedPrefs.getString(KEY_UUID, "") ?: ""
    fun saveUuid(uuid: String) = encryptedPrefs.edit().putString(KEY_UUID, uuid).apply()

    // API Key
    fun getApiKey(): String = encryptedPrefs.getString(KEY_API_KEY, "") ?: ""
    fun saveApiKey(apiKey: String) =
        encryptedPrefs.edit().putString(KEY_API_KEY, apiKey).apply()

    // Registration status
    fun isRegistered(): Boolean = encryptedPrefs.getBoolean(KEY_REGISTERED, false)
    fun setRegistered(registered: Boolean) =
        encryptedPrefs.edit().putBoolean(KEY_REGISTERED, registered).apply()

    // First run
    fun isFirstRun(): Boolean = encryptedPrefs.getBoolean(KEY_FIRST_RUN, true)
    fun setFirstRun(firstRun: Boolean) =
        encryptedPrefs.edit().putBoolean(KEY_FIRST_RUN, firstRun).apply()

    // Clear all
    fun clearAll() = encryptedPrefs.edit().clear().apply()
}
---

