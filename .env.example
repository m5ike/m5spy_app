# My Spy - Environment Configuration
# Copy this file to .env and update with your values
# @author Michael KOJDL
# @version 2.0.0

# ===== Django Configuration =====
SECRET_KEY=django-insecure-CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,myspy.local,*.yourdomain.com

# Django Superuser (created on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@myspy.local
DJANGO_SUPERUSER_PASSWORD=Admin123!ChangeMe

# ===== Database Configuration =====
# Database engine (mysql or postgresql)
DB_ENGINE=django.db.backends.mysql
DB_NAME=myspy_db
DB_USER=myspy_user
DB_PASSWORD=myspy_password_change_me_in_production
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=root_password_change_me_in_production

# MySQL specific
MYSQL_PORT=3306

# ===== Redis Configuration =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me_in_production
REDIS_DB=0

# ===== RabbitMQ Configuration =====
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=myspy
RABBITMQ_PASSWORD=rabbitmq_password_change_me_in_production
RABBITMQ_VHOST=myspy_vhost

# ===== Celery Configuration =====
CELERY_BROKER_URL=amqp://myspy:rabbitmq_password_change_me_in_production@rabbitmq:5672/myspy_vhost
CELERY_RESULT_BACKEND=redis://:redis_password_change_me_in_production@redis:6379/1

# ===== Application Ports =====
WEBAPP_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===== Email Configuration (Optional) =====
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# ===== CORS Configuration =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=False

# ===== Security Settings =====
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# For production, set these to True and appropriate values:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
